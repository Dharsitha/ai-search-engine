# ========================================================
# MindRec Environment Variables Template
# Copy this file to .env and insert your real credentials:
# cp .env.example .env
# ========================================================

# Optional: Google Gemini API Key for Live Web Grounding & RAG Synthesis
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Django Secret Key (Optional - default provided for development)
SECRET_KEY=your_django_secret_key_here
DEBUG=True
